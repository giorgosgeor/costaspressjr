# Costaspressjr — public web root
# Document root on the production server MUST point at /public
# (never the project root). Everything outside /public is private.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS only. Production's session cookie is Secure, so over plain http
    # nobody could sign in or keep a cart; send http:// visitors to https://.
    # X-Forwarded-Proto covers hosts that end TLS at a proxy (Cloudflare, some
    # shared hosts), where HTTPS looks "off" here. Local servers are exempt.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Never execute PHP inside upload directories.
    RewriteRule ^images/designs/uploads/.*\.(php|phtml|phar)$ - [F,L,NC]
    RewriteRule ^images/designs/previews/.*\.(php|phtml|phar)$ - [F,L,NC]
    RewriteRule ^images/products/.*\.(php|phtml|phar)$ - [F,L,NC]
    RewriteRule ^uploads/cart/.*\.(php|phtml|phar)$ - [F,L,NC]

    # If the request maps to a real file or directory, serve it directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise, hand off to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Deny access to sensitive files even if somehow placed under /public.
<FilesMatch "(^\.|\.(env|ini|log|sql|md|sh|bak|swp)$)">
    Require all denied
</FilesMatch>

# Requests that reached a TLS-terminating proxy (Cloudflare, some shared
# hosts) over HTTPS arrive here as plain http, so HTTPS is unset for them;
# FORWARDED_HTTPS marks them for the HSTS header below. The header is safe
# to trust for this: browsers ignore HSTS on a plain-http response.
<IfModule mod_setenvif.c>
    SetEnvIfNoCase X-Forwarded-Proto "^https$" FORWARDED_HTTPS
</IfModule>

# Security headers. HSTS is only sent over HTTPS (production).
# Deliberately not inside <IfModule mod_headers.c>: without the module these
# lines stop Apache serving the site (500, "Invalid command 'Header'" in the
# error log) instead of quietly serving it without its protection.
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "DENY"
Header set Referrer-Policy "strict-origin-when-cross-origin"
# geolocation=(self): the checkout asks for the browser's location to list
# the nearest ACS pickup points. () would refuse it before any prompt.
Header set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
# Direct TLS (HTTPS) or TLS at a proxy (FORWARDED_HTTPS); "set" means a
# request matching both still gets one header.
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=FORWARDED_HTTPS
# Payment happens on Stripe's own hosted Checkout page: the checkout
# sends the browser there by navigation, which this policy doesn't limit,
# so no Stripe script, frame or connection is needed on these pages.
# Everything else is our own: the fonts (/fonts/), interact.js and Leaflet
# (/js/vendor/) are self-hosted, so no visitor's IP address goes to Google
# or a CDN, and no third party can change a script the checkout runs.
# The one exception is the ACS pickup map's tiles, from
# tile.openstreetmap.org (named in the Privacy Policy).
# script-src has no 'unsafe-inline': templates carry no inline <script>
# or on* handlers (page data travels in <script type="application/json">,
# behaviour in data-* attributes - see public/js/site/actions.js), so a
# script injected into a page is refused. Keep it that way: a new inline
# script will simply not run. style-src still allows inline styles.
Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self';"

# Older Apache mime.types files don't know woff2; without a type the
# font caching rules below wouldn't apply to it.
AddType font/woff2 .woff2
AddType font/woff .woff

# Default charset
AddDefaultCharset UTF-8

# Disable directory listings
Options -Indexes

# Compression — text assets gzip well, images don't.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/x-javascript application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caching. Hashed/versioned URLs (?v=mtime via Asset::url) make a long
# Cache-Control safe for CSS/JS. Images are cached for a week — admin uploads
# replace files in place so a multi-year cache would surprise admins.
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"

    ExpiresByType image/png                 "access plus 7 days"
    ExpiresByType image/jpeg                "access plus 7 days"
    ExpiresByType image/webp                "access plus 7 days"
    ExpiresByType image/gif                 "access plus 7 days"
    ExpiresByType image/svg+xml             "access plus 30 days"
    ExpiresByType image/x-icon              "access plus 30 days"

    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"

    # HTML must always revalidate so logged-in/CSRF state is current.
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Belt-and-braces: tell intermediaries not to cache HTML.
    <FilesMatch "\.(php|html?)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
    <FilesMatch "\.(css|js|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|otf)$">
        Header append Cache-Control "public"
    </FilesMatch>
</IfModule>
