# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Application environment: development | production
APP_ENV=development

# Database
DB_HOST=127.0.0.1
DB_NAME=costaspressjr
DB_USER=costaspressjr
DB_PASS=change-me
DB_CHARSET=utf8mb4

# Base public URL, used when building links in emails etc. No trailing slash.
APP_URL=https://www.costaspressjr.com

# Mail
# MAIL_TRANSPORT=log writes messages to the PHP error log (dev default).
# MAIL_TRANSPORT=mail uses PHP mail(); set this only if the host has SMTP set up.
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=no-reply@costaspressjr.local
MAIL_FROM_NAME="Costaspressjr"

# Stripe — get keys from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_... / pk_test_...) for development.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
