# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Application environment: development | production
APP_ENV=development

# Database
DB_HOST=127.0.0.1
DB_NAME=costaspressjr
DB_USER=costaspressjr
DB_PASS=change-me
DB_CHARSET=utf8mb4

# Base public URL, used when building links in emails etc. No trailing slash.
APP_URL=https://www.costaspressjr.com

# ---------------------------------------------------------------------------
# Who runs the shop. EU law requires a web shop to say who is selling, so
# these appear on the contact page, in the footer, and in the Terms and the
# Privacy Policy. Production refuses to start without NAME, ADDRESS and EMAIL;
# anything left empty is simply not shown. Separate lines with "|", e.g.
#   BUSINESS_ADDRESS=12 Example Street | 3036 Limassol | Cyprus
#   BUSINESS_HOURS=Mon–Fri 9:00–18:00 | Sat 10:00–14:00
# Legal name of the seller: the company ("Costas Press Ltd") or your own name.
BUSINESS_NAME=
# A real geographic address (where the business is; not a PO box).
BUSINESS_ADDRESS=
# The email customers see (empty = CONTACT_EMAIL below).
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_HOURS=
# Company registration number (e.g. HE 123456) and VAT number (CY…), if any.
BUSINESS_REG_NO=
BUSINESS_VAT_NO=

# Mail
# MAIL_TRANSPORT=log  writes messages to storage/mail.log (dev default).
# MAIL_TRANSPORT=smtp sends through SMTP_HOST — use this in production.
# MAIL_TRANSPORT=mail uses PHP mail(); usually lands in spam — avoid.
# Production refuses to start with "log": nobody would get their
# verification, password-reset or payment-alert emails.
MAIL_TRANSPORT=log
# Must be an address on a domain whose SPF/DKIM records authorise the SMTP
# provider below, or receiving servers will mark the mail as spam.
MAIL_FROM_ADDRESS=no-reply@costaspressjr.local
MAIL_FROM_NAME="Costaspressjr"
# Where contact-form messages are delivered (Reply-To is the customer, so
# answering just works). Empty = MAIL_FROM_ADDRESS, which nobody reads.
CONTACT_EMAIL=

# SMTP (MAIL_TRANSPORT=smtp). The provider shows these values, e.g. Brevo:
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_ENCRYPTION=tls
# SMTP_ENCRYPTION: tls = STARTTLS (587), ssl = implicit TLS (465),
#                  none = plain text, local test servers only.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# Stripe — get keys from https://dashboard.stripe.com/apikeys
# Use test keys for development, and separate keys per environment.
# STRIPE_SECRET_KEY should be a RESTRICTED key (rk_...), not the sk_ secret
# key, with only: PaymentIntents write, Refunds write, Charges read,
# Disputes read, Balance transactions read (a customer cancelling before
# production is refunded minus Stripe's fee, read from there). If a Stripe call returns 403, add just the permission named.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# With APP_ENV=production the site refuses to start on test keys — anyone
# could "pay" with card 4242 and receive real goods. Set this to 1 only for
# a dry run of the production server before the live keys go in.
STRIPE_ALLOW_TEST_KEYS=
# Webhook signing secret (whsec_...). In the Stripe Dashboard → Developers →
# Webhooks, add https://YOUR-DOMAIN/stripe/webhook with the events
#   payment_intent.succeeded   places the order for a customer who paid and
#                              never came back (e.g. closed the tab after
#                              Revolut Pay/PayPal)
#   charge.refunded, charge.dispute.created, charge.dispute.closed
#                              keep the order's payment status in step with
#                              refunds and disputes made in the Dashboard
# Test and live mode have separate endpoints, each with its own secret.
#
# Who is emailed when a payment needs a person (paid, no order, and the
# automatic refund failed) or database/reconcile_payments.php had to recover
# orders the webhook missed. Comma-separated. Empty = every admin account.
# Run the reconcile job from cron every 30 minutes — see the top of that file.
ALERT_EMAIL=
# Locally: `stripe listen --forward-to localhost:8000/stripe/webhook` prints one.
STRIPE_WEBHOOK_SECRET=
# Which payment methods Stripe's Checkout page shows (card, Apple Pay,
# Google Pay, Revolut Pay, PayPal) is set in the Stripe Dashboard → Settings
# → Payment methods, not here.

# ---------------------------------------------------------------------------
# Delivery. There is no home delivery and no store pickup: every order goes
# to the ACS store or Smartpoint locker the customer picks, for this fixed
# fee in EUR. Required — the checkout takes no orders without it.
ACS_PICKUP_FEE=3.00
# Store pickup is no longer offered; this address only appears on orders
# placed while it was.
STORE_PICKUP_ADDRESS=

# ACS web services — issued by ACS to business customers. With these set,
# /admin/pickup-points can sync every ACS store and Smartpoint locker in
# Cyprus (or run `php database/sync_acs_points.php` from cron). Without them,
# add points by hand on that page.
ACS_API_KEY=
ACS_COMPANY_ID=
ACS_COMPANY_PASSWORD=
ACS_USER_ID=
ACS_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Shop assistant — optional LLM fallback
#
# The assistant works WITHOUT any of this: it answers from the shop's own FAQ,
# info pages, products table and pricing engine. These settings only add a
# model for the questions the intent matcher cannot place, and leaving
# LLM_API_KEY empty disables that layer entirely.
#
# Two request shapes are supported:
#   LLM_PROVIDER=openai   the OpenAI-compatible /chat/completions shape, which
#                         Groq, OpenRouter, Mistral and Cerebras all speak
#   LLM_PROVIDER=gemini   Google's generateContent shape
#
# Groq (free tier, no card, fast — the default suggestion):
#   LLM_PROVIDER=openai
#   LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=gsk_...
#
# Google Gemini (better Greek; note the free tier may train on the data sent,
# so say so in the privacy policy before enabling it on a live shop):
#   LLM_PROVIDER=gemini
#   LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
#   LLM_MODEL=gemini-2.0-flash
#   LLM_API_KEY=AIza...
#
# Verify the model name against the provider's own list before going live —
# free tiers rename and retire models more often than paid ones.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
